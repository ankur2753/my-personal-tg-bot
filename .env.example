# Environment Configuration for my-personal-tg-bot

# Telegram Bot Security & Auth
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Queue Broker Configuration (redis | aws_sqs)
QUEUE_PROVIDER=redis

# Redis Streams Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secret_redis_pass
REDIS_DB=0

# AWS SQS Settings (Optional fallback)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Topic Names
TOPIC_JOB_HUNT_REQUESTS=agent.job-hunt.requests
TOPIC_JOB_HUNT_RESPONSES=agent.job-hunt.responses
TOPIC_FINANCE_REQUESTS=agent.finance.requests
TOPIC_FINANCE_RESPONSES=agent.finance.responses
TOPIC_GLOBAL_NOTIFICATIONS=notifications.global
